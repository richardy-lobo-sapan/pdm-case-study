# Copy this file to .env and fill in the values. .env is git-ignored and never copied into the Docker image.
# Local API: loaded automatically at startup. Docker: docker run --env-file .env -p 8000:8000 pdm-case

# Groq API key for the field-note LLM (create one at https://console.groq.com/keys).
# Leave empty to use the fixed template note instead.
GROQ_API_KEY=
